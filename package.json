    "printers": "node scripts/list-printers.js",
    "agent": "node agent.js",
    "cloud": "CLOUD=true PAYMENT_MODE=upi_manual SIM_ENABLED=false node server.js",
    "selftest": "node scripts/selftest.js"
  },
