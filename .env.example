# Copy to .env and fill in. .env is gitignored — never commit a real UPI ID.
#   cp .env.example .env

# sim = auto-paid (demos only). upi_manual = staff approve each payment at /admin.
PAYMENT_MODE=upi_manual
UPI_VPA=yourname@ybl
UPI_NAME=PrintKiosk IDEA Lab

# Optional: show your own saved bank/PhonePe QR image instead of a generated
# one. Trade-off: a saved QR is static, so it cannot carry the per-order
# amount and the student must type it in. Prefer the generated QR.
# UPI_QR_IMAGE=private/qr.jpeg

# Turn the free-printing simulator off before students use the kiosk.
SIM_ENABLED=false

# Printer
# PRINTER_NAME=Canon_MF240

# Staff approval token. Without it, approvals only work from the kiosk itself.
# ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Cloud deployment (Render) + print agent
# ---------------------------------------------------------------------------
# On the SERVER (set these in Render -> Environment, not in this file):
#   CLOUD=true              printing is handed to the agent, not done locally
#   ADMIN_TOKEN=<random>    required in cloud mode to approve payments at /admin
#   AGENT_TOKEN=<random>    the print agent authenticates with this
#   APPROVAL_SLA_MS=30000   the 30-second approval promise
#
# On the PRINT STATION (the Pi/PC wired to the printer), in its own .env:
# CLOUD_URL=https://your-app.onrender.com
# AGENT_TOKEN=<the same value as on the server>
# PRINTER_NAME=Canon_MF240
#
# then:  npm run agent
